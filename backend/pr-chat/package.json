{
  "name": "@my-sp-pr/pr-chat-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "files": ["dist", "generated", "drizzle"],
  "scripts": {
    "dev": "tsx watch --include '../contracts/dist/**/*.js' --include '../database/dist/**/*.js' src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:generate": "pnpm -w exec drizzle-kit generate --config=backend/pr-chat/drizzle.config.ts",
    "db:check": "pnpm -w exec drizzle-kit check --config=backend/pr-chat/drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@my-sp-pr/contracts": "workspace:*",
    "@my-sp-pr/database": "workspace:*",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
