# 下游默认只接受本机连接。跨容器部署时配合私网设置 HOST。
NODE_ENV=development
HOST=127.0.0.1
PORT=3003

# Admin 浏览器 Origin 与 SSO issuer；生产必须为 HTTPS 且不能带路径。
ADMIN_PUBLIC_ORIGIN=http://localhost:5174
SSO_PUBLIC_ORIGIN=http://localhost:5175
ADMIN_OIDC_CLIENT_ID=pr-admin
ADMIN_OIDC_CLIENT_SECRET=replace_with_at_least_43_random_characters
# JSON key ring；key 与 HMAC key 均使用 `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='` 生成。
ADMIN_TOKEN_ENCRYPTION_KEYS=[{"id":"v1","key":"replace_with_32_byte_base64url_key"}]
ADMIN_CSRF_HMAC_KEY=replace_with_32_byte_base64url_key
ADMIN_AUTH_TIMEOUT_MS=7500

# GitHub App 仅需目标仓库 Contents/Deployments/Environments 访问权和 webhook。
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_FILE=.deploy/github-app.pem
# 可选兼容入口，必须成对提供；新仓库通过目录导入，仓库和 installation 存于数据库。
GITHUB_INSTALLATION_ID=12345678
GITHUB_REPOSITORY=your-owner/my-sp-pr
GITHUB_ALLOWED_OWNERS=your-owner
GITHUB_RUNNER_TARGETS=staging,production
GITHUB_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
GITHUB_API_ORIGIN=https://api.github.com

# PG18：运行与迁移账号分离。Neon 使用同端点直连地址（去除 -pooler）。
DATABASE_URL=postgresql://my_sp_pr_admin_app:replace_me@localhost:5432/my_sp_pr
DATABASE_MIGRATION_URL=postgresql://my_sp_pr_admin_migrator:replace_me@localhost:5432/my_sp_pr
# 本机可 disable；Neon 使用 verify-full。生产必须显式设置。
DATABASE_SSL_MODE=disable
# 自签证书时提供绝对路径；默认使用系统信任链。
# DATABASE_SSL_CA_FILE=/absolute/path/to/ca.pem
# 连接地址与证书名称不同时显式提供；仅和 verify-full + CA 一起使用。
# DATABASE_SSL_SERVERNAME=db.example.internal
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=3000
DATABASE_QUERY_TIMEOUT_MS=4000
DATABASE_IDLE_TIMEOUT_MS=30000
