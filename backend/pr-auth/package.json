{
  "name": "@my-sp-pr/pr-auth-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "generated",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --include '../contracts/dist/**/*.js' --include '../database/dist/**/*.js' src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:generate": "pnpm -w exec drizzle-kit generate --config=backend/pr-auth/drizzle.config.ts",
    "db:check": "pnpm -w exec drizzle-kit check --config=backend/pr-auth/drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "auth:keys": "tsx src/scripts/generate-keys.ts",
    "auth:bootstrap": "tsx src/scripts/bootstrap-auth.ts",
    "auth:set-role": "tsx src/scripts/set-role.ts",
    "auth:reset-password": "tsx src/scripts/reset-password.ts",
    "auth:cleanup": "tsx src/scripts/cleanup-auth.ts"
  },
  "dependencies": {
    "@my-sp-pr/contracts": "workspace:*",
    "@my-sp-pr/database": "workspace:*",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "jose": "6.2.12",
    "oidc-provider": "9.12.2",
    "openid-client": "6.8.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/oidc-provider": "9.12.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
