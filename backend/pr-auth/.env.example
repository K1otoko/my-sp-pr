# 下游默认只接受本机连接。跨容器部署时配合私网设置 HOST。
NODE_ENV=development
HOST=127.0.0.1
PORT=3002

# Gateway 和身份服务必须一致；无末尾斜杠。生产必须为稳定 HTTPS Origin。
SSO_PUBLIC_ORIGIN=http://localhost:5175
# 相对路径以 backend/pr-auth 为根；生产可注入绝对路径。文件必须 0600。
# 使用 pnpm --filter @my-sp-pr/pr-auth-api auth:keys 显式生成，禁止提交 Git。
AUTH_CONFIG_FILE=.deploy/auth.json
# 只信任实际 Gateway 地址，不能设置任意来源。
AUTH_TRUSTED_GATEWAY_CIDRS=loopback

# PG18：运行与迁移账号分离。Neon 使用同端点直连地址（去除 -pooler）。
DATABASE_URL=postgresql://my_sp_pr_auth_app:replace_me@localhost:5432/my_sp_pr
DATABASE_MIGRATION_URL=postgresql://my_sp_pr_auth_migrator:replace_me@localhost:5432/my_sp_pr
# 本机可 disable；Neon 使用 verify-full。生产必须显式设置。
DATABASE_SSL_MODE=disable
# 自签证书时提供绝对路径；默认使用系统信任链。
# DATABASE_SSL_CA_FILE=/absolute/path/to/ca.pem
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=3000
DATABASE_QUERY_TIMEOUT_MS=4000
DATABASE_IDLE_TIMEOUT_MS=30000
