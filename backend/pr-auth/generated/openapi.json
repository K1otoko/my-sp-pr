{
  "openapi": "3.0.3",
  "info": {
    "title": "PR Auth API",
    "version": "0.1.0",
    "description": "自动生成，请修改 backend/contracts/src/ 下对应服务的 *.contract.ts 或 shared.ts 后运行 pnpm generate:api。"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "$ref": "#/components/schemas/HealthData"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "HealthData": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "uptime": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "service",
          "timestamp",
          "uptime"
        ],
        "description": "服务状态与进程运行秒数"
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "success",
          "error"
        ],
        "description": "统一错误响应"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "NOT_FOUND",
          "CORS_FORBIDDEN",
          "INVALID_JSON",
          "PAYLOAD_TOO_LARGE",
          "INTERNAL_ERROR",
          "UPSTREAM_UNAVAILABLE",
          "UPSTREAM_TIMEOUT",
          "DATABASE_NOT_READY",
          "INVALID_CREDENTIALS",
          "INTERACTION_EXPIRED",
          "INVALID_INTERACTION",
          "INVALID_INPUT",
          "CSRF_INVALID",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "RATE_LIMITED",
          "AUTH_FLOW_INVALID",
          "AUTH_UNAVAILABLE"
        ]
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "$ref": "#/components/schemas/ReadinessData"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "ReadinessData": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          },
          "service": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "ok"
                ]
              }
            },
            "required": [
              "database"
            ]
          }
        },
        "required": [
          "status",
          "service",
          "timestamp",
          "checks"
        ]
      },
      "AuthInteractionData": {
        "type": "object",
        "properties": {
          "clientName": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "enum": [
              "login"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "clientName",
          "prompt",
          "expiresAt",
          "csrfToken"
        ]
      },
      "AuthResumeData": {
        "type": "object",
        "properties": {
          "resumeUrl": {
            "type": "string"
          }
        },
        "required": [
          "resumeUrl"
        ]
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "csrfToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "username",
          "password",
          "csrfToken"
        ],
        "additionalProperties": false
      },
      "AuthSessionData": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "authenticated": {
                "type": "boolean",
                "enum": [
                  false
                ]
              }
            },
            "required": [
              "authenticated"
            ]
          },
          {
            "type": "object",
            "properties": {
              "authenticated": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "user": {
                "$ref": "#/components/schemas/AuthUser"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "idleExpiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "csrfToken": {
                "type": "string"
              }
            },
            "required": [
              "authenticated",
              "user",
              "expiresAt",
              "idleExpiresAt",
              "csrfToken"
            ]
          }
        ]
      },
      "AuthUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/AuthRole"
          }
        },
        "required": [
          "id",
          "username",
          "displayName",
          "role"
        ]
      },
      "AuthRole": {
        "type": "string",
        "enum": [
          "admin",
          "user"
        ]
      },
      "CsrfInput": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "csrfToken"
        ],
        "additionalProperties": false
      },
      "LogoutContextData": {
        "type": "object",
        "properties": {
          "clientName": {
            "type": "string"
          },
          "xsrf": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "/api/auth/oidc/logout/confirm"
            ]
          }
        },
        "required": [
          "clientName",
          "xsrf",
          "action"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/auth/health": {
      "get": {
        "operationId": "getAuthHealth",
        "summary": "查询服务健康状态",
        "responses": {
          "200": {
            "description": "服务正常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "400": {
            "description": "JSON 格式错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "请求体超过限制",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/ready": {
      "get": {
        "operationId": "getAuthReadiness",
        "summary": "查询服务与数据库就绪状态",
        "responses": {
          "200": {
            "description": "服务就绪",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "服务尚未就绪",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/interactions/{uid}": {
      "get": {
        "operationId": "getAuthInteraction",
        "summary": "读取登录交互（Accept: application/json）",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,256}$/u"
            },
            "required": true,
            "name": "uid",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/AuthInteractionData"
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          },
          "303": {
            "description": "浏览器导航至登录页"
          },
          "400": {
            "description": "请求无效或流程过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "凭证错误或未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "请求校验失败或无权访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "该登录请求已处理",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "请求体超过限制",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "身份服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
