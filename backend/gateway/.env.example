# 生产必须显式设置三个上游地址和前端 Origin。
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CHAT_SERVICE_URL=http://127.0.0.1:3001
AUTH_SERVICE_URL=http://127.0.0.1:3002
ADMIN_SERVICE_URL=http://127.0.0.1:3003
UPSTREAM_TIMEOUT_MS=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
SSO_PUBLIC_ORIGIN=http://localhost:5175
# 默认直连，不信任客户端传入的 X-Forwarded-For。
# 生产由本机 Nginx 转发时可设 loopback；跨容器只列真实入口 IP/CIDR。
TRUSTED_PROXY_CIDRS=
